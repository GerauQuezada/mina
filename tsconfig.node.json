{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "server/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "src/lib/**/*.ts", "src/three/**/*.ts", "supabase/functions/_shared/**/*.ts"]
}
